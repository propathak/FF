# ---------------------------------------------------------------------------
# Index Joy — environment configuration
# Every key below is OPTIONAL. With none of them set the app runs a complete
# free-tier audit and honestly labels everything it could not measure.
# ---------------------------------------------------------------------------

# --- Database (optional: falls back to an in-memory store for local dev) ----
# Any Postgres provider (Neon, Railway, RDS, local). Preferred, and portable.
# Apply supabase/migrations/0001_init.sql first — it is standard Postgres.
DATABASE_URL=

# Or Supabase's REST API instead. DATABASE_URL wins if both are set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used only by the Postgres driver's integration tests; they skip without it.
TEST_DATABASE_URL=

# --- Sign-in (Google) -------------------------------------------------------
# Required to run an audit. Create an OAuth 2.0 Client ID (type: Web
# application) at https://console.cloud.google.com/apis/credentials
#   Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Signing key for session cookies:  openssl rand -base64 32
AUTH_SECRET=

# Google accounts allowed into /admin, comma separated. Empty locks everyone out.
ADMIN_EMAILS=

# --- Google Sheet logging ---------------------------------------------------
# Every sign-in appends to a "Users" tab and every audit to an "Audits" tab.
# Both tabs are created automatically. Setup: create a blank spreadsheet, then
# share it (Editor) with the service account email below.
# The ID is the long string in the sheet's URL between /d/ and /edit.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the "private_key" value from the service account JSON, newlines as \n.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Google PageSpeed Insights ---------------------------------------------
# Works without a key at a lower quota. With a key: 25,000 queries/day.
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# --- LLM interpretation (prose + question generation only, never scoring) ---
# Without this the app uses deterministic templates instead.
ANTHROPIC_API_KEY=
ANTHROPIC_PROSE_MODEL=claude-opus-5
ANTHROPIC_BULK_MODEL=claude-haiku-4-5

# --- SERP / AI Overview enrichment (paid; enables audit Mode B) -------------
# SERP_PROVIDER: "none" | "serper" | "dataforseo"
SERP_PROVIDER=none
SERPER_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- AI answer sampling (paid; enables audit Mode A) ------------------------
# Comma separated: perplexity,gemini
AI_ANSWER_PROVIDERS=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# --- Free authority proxy (30k domains/month free) -------------------------
# https://www.domcop.com/openpagerank/
OPEN_PAGERANK_API_KEY=

# --- Email ------------------------------------------------------------------
RESEND_API_KEY=
REPORT_FROM_EMAIL="Index Joy <reports@example.com>"

# --- Scheduling -------------------------------------------------------------
# A Cal.com or Calendly booking URL rendered in the unlock step.
NEXT_PUBLIC_BOOKING_URL=

# --- Analytics --------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Agency branding --------------------------------------------------------
NEXT_PUBLIC_AGENCY_NAME="Your Agency"
# Production: https://indexjoy.com — see docs/08-deployment.md
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cost + abuse controls --------------------------------------------------
# Permits auditing localhost/IP targets. Off in production — accepting them
# would turn the public audit endpoint into an SSRF probe against internal hosts.
AUDIT_ALLOW_LOCAL=0

AUDIT_MAX_PAGES=25
AUDIT_MAX_COMPETITOR_PAGES=10
AUDIT_BUDGET_CENTS=50
AUDITS_PER_DOMAIN_PER_DAY=3
