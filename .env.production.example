# ---------------------------------------------------------------------------
# Index Joy — production environment (indexjoy.com)
#
# Paste these into Vercel → Project → Settings → Environment Variables,
# scoped to "Production". Do NOT commit real values to git.
# ---------------------------------------------------------------------------

# === REQUIRED ==============================================================

# A database is required. Without one, /api/audits returns 503 by design: each
# serverless invocation is a separate instance, so an audit written by one
# would 404 when polled by another. See docs/08-deployment.md §2.
#
# EITHER (recommended) — any Postgres provider. Use the POOLED connection
# string; on Vercel each invocation is its own process and an unpooled URL
# exhausts the server's connection limit under load.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# OR — Supabase's REST API instead. DATABASE_URL wins if both are set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL. The app works this out from Vercel's own domain, so leave it blank
# unless you are hosting somewhere else. Drives robots.txt, sitemap.xml, the
# social preview tags and the report links written to the Google Sheet.
NEXT_PUBLIC_APP_URL=

# --- Sign-in (Google) ---
# OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
#   Authorised redirect URI: https://indexjoy.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Session cookie signing key:  openssl rand -base64 32
AUTH_SECRET=

# Google accounts allowed into /admin, comma separated. Empty locks everyone out.
ADMIN_EMAILS=

# --- Google Sheet logging ---
# Sign-ins append to a "Users" tab, audits to an "Audits" tab. Both are created
# automatically — you only create a blank spreadsheet and share it with the
# service account below (Editor). See docs/09-signin-and-sheet.md.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The "private_key" from the service account JSON, with newlines as \n.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# The agency credit in the report and site footer.
NEXT_PUBLIC_AGENCY_NAME=

# === STRONGLY RECOMMENDED ==================================================

# Free. Raises PageSpeed to 25,000 queries/day; unkeyed traffic shares a pool
# and will start returning 429 as soon as you have real volume.
# https://console.cloud.google.com → enable "PageSpeed Insights API" → API key
PAGESPEED_API_KEY=

# Report prose and question generation. Without it the app falls back to
# deterministic templates — it still works, it just reads more generically.
ANTHROPIC_API_KEY=
ANTHROPIC_PROSE_MODEL=claude-opus-5
ANTHROPIC_BULK_MODEL=claude-haiku-4-5

# Free: 30,000 domains/month. The only authority signal in the free tier.
# https://www.domcop.com/openpagerank/
OPEN_PAGERANK_API_KEY=

# === ENABLE WHEN YOU START CAPTURING LEADS =================================

# ~$0.024 per qualified lead. This is what turns "estimated" into "measured"
# on third-party citations and Google AI Overviews — the most persuasive
# slide in the report. Turn it on once leads are flowing.
SERP_PROVIDER=none
SERPER_API_KEY=

# Report delivery. Free tier is 3,000/month BUT capped at 100/day —
# the daily cap binds first. Verify indexjoy.com as a sending domain.
RESEND_API_KEY=
REPORT_FROM_EMAIL="Index Joy <reports@indexjoy.com>"

# Booking link rendered after the lead form (Cal.com or Calendly).
NEXT_PUBLIC_BOOKING_URL=

# Funnel analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# === OPTIONAL: AI ANSWER SAMPLING (audit Mode A) ===========================
# ~$0.22 per audit. Only enable for high-value prospects or scheduled runs.
AI_ANSWER_PROVIDERS=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# === COST + ABUSE CONTROLS =================================================
AUDIT_ALLOW_LOCAL=0
AUDIT_MAX_PAGES=25
AUDIT_MAX_COMPETITOR_PAGES=10
AUDIT_BUDGET_CENTS=50
AUDITS_PER_DOMAIN_PER_DAY=3
