# ---------------------------------------------------------------------------
# Index Joy — production environment (indexjoy.com)
#
# Paste these into Vercel → Project → Settings → Environment Variables,
# scoped to "Production". Do NOT commit real values to git.
# ---------------------------------------------------------------------------

# === REQUIRED ==============================================================

# Without these, /api/audits returns 503 by design: each serverless invocation
# is a separate instance, so an audit written by one would 404 when polled by
# another. See docs/08-deployment.md §2.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin. Drives robots.txt, sitemap.xml, OG tags and share links.
NEXT_PUBLIC_APP_URL=https://indexjoy.com

# Gate for /admin. Use a long random string, not a password you reuse.
#   openssl rand -base64 32
ADMIN_PASSWORD=

# The agency credit in the report and site footer.
NEXT_PUBLIC_AGENCY_NAME=

# === STRONGLY RECOMMENDED ==================================================

# Free. Raises PageSpeed to 25,000 queries/day; unkeyed traffic shares a pool
# and will start returning 429 as soon as you have real volume.
# https://console.cloud.google.com → enable "PageSpeed Insights API" → API key
PAGESPEED_API_KEY=

# Report prose and question generation. Without it the app falls back to
# deterministic templates — it still works, it just reads more generically.
ANTHROPIC_API_KEY=
ANTHROPIC_PROSE_MODEL=claude-opus-5
ANTHROPIC_BULK_MODEL=claude-haiku-4-5

# Free: 30,000 domains/month. The only authority signal in the free tier.
# https://www.domcop.com/openpagerank/
OPEN_PAGERANK_API_KEY=

# === ENABLE WHEN YOU START CAPTURING LEADS =================================

# ~$0.024 per qualified lead. This is what turns "estimated" into "measured"
# on third-party citations and Google AI Overviews — the most persuasive
# slide in the report. Turn it on once leads are flowing.
SERP_PROVIDER=none
SERPER_API_KEY=

# Report delivery. Free tier is 3,000/month BUT capped at 100/day —
# the daily cap binds first. Verify indexjoy.com as a sending domain.
RESEND_API_KEY=
REPORT_FROM_EMAIL="Index Joy <reports@indexjoy.com>"

# Booking link rendered after the lead form (Cal.com or Calendly).
NEXT_PUBLIC_BOOKING_URL=

# Funnel analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# === OPTIONAL: AI ANSWER SAMPLING (audit Mode A) ===========================
# ~$0.22 per audit. Only enable for high-value prospects or scheduled runs.
AI_ANSWER_PROVIDERS=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# === COST + ABUSE CONTROLS =================================================
AUDIT_ALLOW_LOCAL=0
AUDIT_MAX_PAGES=25
AUDIT_MAX_COMPETITOR_PAGES=10
AUDIT_BUDGET_CENTS=50
AUDITS_PER_DOMAIN_PER_DAY=3
